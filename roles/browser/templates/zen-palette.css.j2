/* ~/.config/zen/shared/zen-palette.css — runtime accent palette for Zen. */
/* Rendered by roles/browser and overwritten live by `,theme.sh apply_zen` (roles/browser owns the static seed). */
/* Imported by userChrome.css and userContent.css. */

@media (prefers-color-scheme: light) {
  :root {
    --qf-accent: {{ theme_accent_hex }};
  }
}

@media (prefers-color-scheme: dark) {
  :root {
    --qf-accent: {{ theme_accent_hex }};
  }
}
