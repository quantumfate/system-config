[Unit]
Description=Periodic Linear to Obsidian sync

[Timer]
# Wall-clock rather than monotonic: Persistent= only applies to OnCalendar, and
# a monotonic OnBootSec= stops rescheduling once it has elapsed.
OnCalendar={{ obsidian_linear_interval }}
# A window missed while suspended or logged out syncs once on resume.
Persistent=true
Unit=obsidian-linear-sync.service

[Install]
WantedBy=timers.target
