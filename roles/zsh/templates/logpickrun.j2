#!/usr/bin/env bash
# logpickrun — the picker, running inside a tmux window of the log server.
#
# fzf needs a tty, which a Hyprland keybind has none of, so `logview` opens this
# inside the viewer instead. The window renames itself after the chosen source
# and then becomes the stream, keeping the window bar readable.
set -uo pipefail

spec="$(logpick)" || exit 0
[ -n "$spec" ] || exit 0

name="$(printf '%s' "${spec#*:}" | sed 's/\.service$//' | cut -c1-18)"
[ -n "${TMUX:-}" ] && tmux rename-window "$name"

exec logstream "$spec"
