typeset -U path
{% for p in env_paths %}
path=( "{{ p }}" $path )
{% endfor %}
{% if devenv %}
{% for p in env_paths_devenv %}
path=( "{{ p }}" $path )
{% endfor %}
{% endif %}

{% for key, value in env_vars.items() %}
export {{ key }}="{{ value }}"
{% endfor %}

{% for key, value in env_session_vars.items() %}
export {{ key }}="{{ value }}"
{% endfor %}
