# ~/.config/kitty/kitty.conf — rendered by roles/zsh.
#
# kitty owns typography and space — glyph size, row height, padding around the
# grid. Nothing drawing inside the cells (tmux, neovim) can change them.

font_family      {{ zsh_terminal_font }}
bold_font        {{ zsh_terminal_font }} Bold
italic_font      {{ zsh_terminal_font }} Italic
bold_italic_font {{ zsh_terminal_font }} Bold Italic
font_size {{ zsh_terminal_font_size }}

# Leading. Adds air between rows without touching glyph size.
modify_font cell_height {{ zsh_terminal_line_height }}%

# Air around the grid, T R B L. More on top, for the tmux status bar.
window_padding_width {{ zsh_terminal_padding }}
background_opacity 1.0
background_blur 32
hide_window_decorations yes
confirm_os_window_close 0

# Shared accent, and never blinking — motion in the periphery while reading.
cursor {{ zsh_log_accent }}
cursor_shape block
cursor_blink_interval 0

scrollback_lines 10000
scrollbar never

copy_on_select yes
strip_trailing_spaces smart
enable_audio_bell no
allow_remote_control no

# tmux already owns windows and sessions; two bars is duplicated chrome.
tab_bar_style hidden

map ctrl+plus change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0 change_font_size all 0

shell_integration enabled

# Catppuccin Macchiato, installed by roles/theming. The source of the ANSI 16
# that tspin, grep and ls colour against. A missing include is a startup error,
# so never point this at a file another role might remove.
include themes/macchiato.conf
