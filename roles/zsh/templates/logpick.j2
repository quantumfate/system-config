#!/usr/bin/env bash
# logpick — fuzzy-pick a log source, print its logstream spec. Rendered by roles/zsh.
#
# Ordered by how often each entry is needed, not alphabetically, so the top of
# the list holds still and becomes muscle memory.
set -uo pipefail

WORKDIR="${ZSH_LOG_DIR:-{{ zsh_log_dir }}}"

# uwsm scopes are `app-<compositor>-<app>-<id>.scope`, with the app name in the
# Description — except for .desktop launches, which have none, so fall back to
# parsing the unit name.
uwsm_apps() {
  SYSTEMD_COLORS=0 systemctl --user list-units 'app-*.scope' --state=running \
    --no-legend --plain --no-pager 2>/dev/null |
    while read -r unit _load _active _sub desc; do
      case "$desc" in "" | app-*) desc="" ;; esac
      if [ -n "$desc" ]; then
        name="$desc"
      else
        name="${unit%.scope}"
        name="${name#app-}"
        name="${name%-*}"      # the trailing pid / random id
        name="${name//\\x2d/-}"
      fi
      printf 'user:%-40s uwsm app (%s)\n' "$unit" "$name"
    done
}

sources() {
  printf '%s\n' \
    "follow      live journal, all units" \
    "errors      this boot, priority err and worse" \
    "warnings    this boot, priority warning and worse" \
    "kernel      kernel ring buffer" \
    "boot        this boot, from the top" \
    "prev        previous boot, from the top" \
    "audit       audit / access denials"

  # Every GUI program Hyprland starts is a user `app-*.scope`, which no
  # --type=service listing shows. journalctl -u takes a scope name fine.
  uwsm_apps

  systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null \
    | awk '{printf "unit:%-40s system service (running)\n", $1}'
  systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null \
    | awk '{printf "user:%-40s user service (running)\n", $1}'

  if [ -d "$WORKDIR" ]; then
    find -L "$WORKDIR" -maxdepth 3 -type f \( -name '*.log' -o -name '*.txt' -o -name '*.json' \) 2>/dev/null \
      | sed "s|^|file:|" | awk '{printf "%-45s workspace file\n", $1}'
  fi
}

choice=$(sources | fzf \
  --prompt='log ❯ ' \
  --height='100%' \
  --layout=reverse \
  --info=inline \
  --no-multi \
  --no-scrollbar \
  --border=none \
  --pointer='▌' \
  --color='bg+:#363a4f,fg+:#cad3f5,hl:{{ zsh_log_accent }},hl+:{{ zsh_log_accent }},pointer:{{ zsh_log_accent }},prompt:{{ zsh_log_accent }},info:#6e738d,border:#363a4f,gutter:-1' \
  --header='enter open   esc cancel' \
  --header-first)

[ -z "${choice:-}" ] && exit 1
printf '%s\n' "${choice%% *}"
