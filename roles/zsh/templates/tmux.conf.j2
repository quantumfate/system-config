# ~/.tmux.conf — CODING tmux server. Rendered by roles/zsh.
# The log server lives on its own socket (~/.config/tmux/logs.conf, same role).
# Same scheme, same C-b prefix, different socket: no shared state between them.

set -g mouse on
set -g prefix C-b
bind C-b send-prefix

set -ga update-environment "TERM"
set -ga update-environment "TERM_PROGRAM"
# tms runs from the session's environment, so without this it keeps whatever
# fzf options the server was born with.
set -ga update-environment "FZF_DEFAULT_OPTS"
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-kitty:RGB"
set -g focus-events on

# --- Look: Catppuccin Macchiato, accent {{ zsh_log_accent }}, hardcoded.
# Two rows, the second empty as a gap under the chrome. No #() hooks anywhere in
# the bar: nothing polls, so tmux never redraws on a timer and flickers popups.
set -g status 2
set -g status-position top
set -g status-justify left
set -g status-interval 60
set -g status-style "bg=default,fg=#6e738d"
set -g 'status-format[1]' ""

# A budget: left + windows + right must fit, or tmux silently drops the window
# list.
set -g status-left-length 60
set -g status-right-length 80

# Session chip, doubling as the prefix indicator: it inverts while the prefix is
# held. Commas inside #[...] are escaped as #, since #{?...} splits arms on them.
set -g status-left "#{?client_prefix,#[bg={{ zsh_log_accent }}#,fg=#24273a#,bold],#[fg={{ zsh_log_accent }}#,bold]} #S #[default] "

# The session list — where you can jump to. #{S:fmt,current-fmt} is tmux's own
# loop; a #() shell hook cannot work here, the outer format expands #S first.
# `nobold` on the separator matters: a style tag setting only fg leaves bold on.
set -g status-right "#[fg=#6e738d]#{S:#{session_name} ,#[fg={{ zsh_log_accent }}#,bold]#{session_name}#[fg=#6e738d#,nobold] }"

setw -g window-status-format "#[fg=#6e738d] #I #W#{?window_bell_flag, !,} "
setw -g window-status-current-format "#[fg={{ zsh_log_accent }},bold] #I #W#{?window_zoomed_flag, +,} "
setw -g window-status-separator ""

# Concrete colour, or the pane beneath bleeds through.
set -g popup-style "bg=#24273a"
set -g popup-border-style "fg=#363a4f,bg=#24273a"
set -g popup-border-lines rounded

set -g pane-border-style "fg=#363a4f"
set -g pane-active-border-style "fg={{ zsh_log_accent }}"
set -g message-style "bg=#363a4f,fg=#cad3f5"
set -g mode-style "bg=#363a4f,fg=#cad3f5"
set -g menu-style "bg=#24273a,fg=#cad3f5"
set -g menu-selected-style "bg=#5b6078,fg=#cad3f5,bold"
set -g menu-border-style "fg=#363a4f"

run ~/.config/tmux/plugins/tmux-cpu/cpu.tmux
run ~/.config/tmux/plugins/tmux-battery/battery.tmux

# Pickers run in a throwaway window, not a popup — a popup bleeds the pane
# beneath until the picker repaints. No #{...} in the shell strings: tmux would
# expand them before the shell runs.
bind C-o new-window -n tms "tms"
bind C-s new-window -n tms "zsh -ic \"tmux list-sessions -F '#S' | fzf --reverse --no-preview | xargs -r tmux switch-client -t\""
bind C-w new-window -n tms "zsh -ic \"tmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' | fzf --reverse --no-preview | cut -d' ' -f1 | xargs -r tmux select-window -t\""
bind C-e command-prompt -p "Rename active session to: " "run-shell 'tms rename %1'"
bind C-r "run-shell 'tms refresh'"
bind C-k confirm -p "Kill current session? (y/N):" "run-shell 'tms kill'"
bind -r '(' switch-client -p\; refresh-client -S
bind -r ')' switch-client -n\; refresh-client -S

# The one view showing windows nested under sessions, so it stays choose-tree.
# -F replaces its raw default format, -Z zooms, -O activity sorts by most recent
# (tmux rejects `time`), -N drops the preview pane.
bind s choose-tree -Zs -O activity -N \
  -F "#{?session_attached,#[fg={{ zsh_log_accent }}#,bold],#[fg=#cad3f5]}#{session_name}#[default]#[fg=#6e738d]  #{session_windows}w#{?session_attached, ·  attached,}"

# A which-key menu that runs the bindings above, not a legend. Each entry's
# middle field is the key that selects it, so the menu teaches the shortcut.
# tmux's own list-keys dump moves to `C-b /`. Empty "" rows are separators.
bind ? display-menu -T "#[fg={{ zsh_log_accent }},bold] tmux " -x C -y C \
  "open or create a project session"  o  "new-window -n tms 'tms'" \
  "" \
  "pick a session"                    s  "new-window -n tms \"zsh -ic 'tmux list-sessions -F \\\"#S\\\" | fzf --reverse --no-preview | xargs -r tmux switch-client -t'\"" \
  "pick a window, anywhere"           w  "new-window -n tms \"zsh -ic 'tmux list-windows -a -F \\\"#{session_name}:#{window_index} #{window_name}\\\" | fzf --reverse --no-preview | cut -d\\\" \\\" -f1 | xargs -r tmux select-window -t'\"" \
  "session tree"                      t  "choose-tree -Zs -O activity -N" \
  "" \
  "previous session"                  p  "switch-client -p" \
  "next session"                      n  "switch-client -n" \
  "" \
  "rename this session"               e  "command-prompt -p 'Rename active session to: ' \"run-shell 'tms rename %1'\"" \
  "refresh the session list"          r  "run-shell 'tms refresh'" \
  "kill this session"                 k  "confirm -p 'Kill current session? (y/N):' \"run-shell 'tms kill'\"" \
  "" \
  "all key bindings"                  /  "list-keys -N"

bind / list-keys -N
