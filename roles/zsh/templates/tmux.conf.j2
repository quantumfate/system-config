# ~/.tmux.conf — CODING tmux server. Rendered by roles/zsh.
# The log server lives on its own socket (~/.config/tmux/logs.conf, same role).
# Same scheme, same C-b prefix, different socket: no shared state between them.

set -g mouse on
set -g prefix C-b
bind C-b send-prefix

set -ga update-environment "TERM"
set -ga update-environment "TERM_PROGRAM"
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-kitty:RGB"
set -g focus-events on

# --- Look: Catppuccin Macchiato, accent {{ zsh_log_accent }} (mauve), hardcoded.
# One accent, one surface, dim grey elsewhere; active item is bold accented text,
# not a filled block. The bar is two rows and the second is empty (a gap so the
# newest content never sits flush against the chrome). No #() shell hooks in the
# bar — nothing polls, so tmux never redraws on a timer (which would flicker
# popups) and the bar cannot lie about state between ticks.
set -g status 2
set -g status-position top
set -g status-justify left
set -g status-interval 60
set -g status-style "bg=default,fg=#6e738d"
set -g 'status-format[1]' ""

# The two lengths are a budget: left + windows + right must fit the terminal or
# tmux silently drops the window list (which is what hid it before). The right
# side is only the session list now, so it stays well inside 80.
set -g status-left-length 60
set -g status-right-length 80

# status-left is the session chip AND the prefix indicator: while the prefix is
# held the chip inverts to a filled accent block. A whole extra "PREFIX" word is
# noise — the state only has to be unmissable, not spelled out. Commas inside
# #[...] are escaped as #, because #{?...} splits its arms on commas.
set -g status-left "#{?client_prefix,#[bg={{ zsh_log_accent }}#,fg=#24273a#,bold],#[fg={{ zsh_log_accent }}#,bold]} #S #[default] "

# status-right is the session list and nothing else: where you can jump to.
# #{S:fmt,current-fmt} is tmux's own loop over it — the previous #() shell hook
# expanded #S in the *outer* format before the shell ever ran, so it printed the
# current session's name once per session ("system-config system-config").
# nobold on the separator matters: a style tag that only sets fg leaves bold on.
#
# The active pane's directory used to sit here and was dropped: tms names a
# session after its project directory, so it printed the session chip's text a
# second time, in a second colour. The clock went with it — tmux is inside a
# terminal, inside a bar-having compositor, both of which already have one.
set -g status-right "#[fg=#6e738d]#{S:#{session_name} ,#[fg={{ zsh_log_accent }}#,bold]#{session_name}#[fg=#6e738d#,nobold] }"

setw -g window-status-format "#[fg=#6e738d] #I #W#{?window_bell_flag, !,} "
setw -g window-status-current-format "#[fg={{ zsh_log_accent }},bold] #I #W#{?window_zoomed_flag, +,} "
setw -g window-status-separator ""

# Opaque popup bg: a concrete colour prevents pane content bleeding through.
set -g popup-style "bg=#24273a"
set -g popup-border-style "fg=#363a4f,bg=#24273a"
set -g popup-border-lines rounded

set -g pane-border-style "fg=#363a4f"
set -g pane-active-border-style "fg={{ zsh_log_accent }}"
set -g message-style "bg=#363a4f,fg=#cad3f5"
set -g mode-style "bg=#363a4f,fg=#cad3f5"
set -g menu-style "bg=#24273a,fg=#cad3f5"
set -g menu-selected-style "bg=#5b6078,fg=#cad3f5,bold"
set -g menu-border-style "fg=#363a4f"

run ~/.config/tmux/plugins/tmux-cpu/cpu.tmux
run ~/.config/tmux/plugins/tmux-battery/battery.tmux

# tms pickers run in a throwaway window (not a popup — a popup bleeds the pane
# beneath through until the picker repaints). Fzf over tmux's own lists, with the
# fzf theme from .zshrc. No #{...} formats in the shell strings: tmux would
# expand them before the shell runs. C-s switches to a listed session.
bind C-o new-window -n tms "tms"
bind C-s new-window -n tms "zsh -ic \"tmux list-sessions -F '#S' | fzf --reverse --no-preview | xargs -r tmux switch-client -t\""
bind C-w new-window -n tms "zsh -ic \"tmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' | fzf --reverse --no-preview | cut -d' ' -f1 | xargs -r tmux select-window -t\""
bind C-e command-prompt -p "Rename active session to: " "run-shell 'tms rename %1'"
bind C-r "run-shell 'tms refresh'"
bind C-k confirm -p "Kill current session? (y/N):" "run-shell 'tms kill'"
bind -r '(' switch-client -p\; refresh-client -S
bind -r ')' switch-client -n\; refresh-client -S
