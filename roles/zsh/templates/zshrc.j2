## extract() — one command for any archive.
extract() {
  if [[ -z "$1" ]]; then echo "usage: extract <archive>"; return 1; fi
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.tar.zst) tar --zstd -xf "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.rar)     unrar x "$1" ;;
    *.gz)      gunzip "$1" ;;
    *.tar)     tar xf "$1" ;;
    *.tbz2)    tar xjf "$1" ;;
    *.tgz)     tar xzf "$1" ;;
    *.zip)     unzip "$1" ;;
    *.Z)       uncompress "$1" ;;
    *.7z)      7z x "$1" ;;
    *) echo "'$1' cannot be extracted"; return 1 ;;
  esac
}

## Coloured man pages via $LESS_TERMCAP, in the same palette as everything
## else — 24-bit escapes built from {{ '{{ zsh_palette }}' }} rather than the
## 256-colour approximations these variables usually carry.
{% macro fg(hex) %}38;2;{{ hex[1:3]|int(base=16) }};{{ hex[3:5]|int(base=16) }};{{ hex[5:7]|int(base=16) }}{% endmacro %}
export LESS_TERMCAP_mb=$'\e[01;{{ fg(zsh_palette.red) }}m'      # begin blink
export LESS_TERMCAP_md=$'\e[01;{{ fg(zsh_palette.mauve) }}m'    # begin bold — headings
export LESS_TERMCAP_me=$'\e[0m'                       # end bold
export LESS_TERMCAP_se=$'\e[0m'                       # end standout
export LESS_TERMCAP_so=$'\e[{{ fg(zsh_palette.base) }};48;2;{{ zsh_palette.yellow[1:3]|int(base=16) }};{{ zsh_palette.yellow[3:5]|int(base=16) }};{{ zsh_palette.yellow[5:7]|int(base=16) }}m'  # begin standout — the search/prompt bar
export LESS_TERMCAP_ue=$'\e[0m'                       # end underline
export LESS_TERMCAP_us=$'\e[04;{{ fg(zsh_palette.teal) }}m'     # begin underline — arguments

# One palette everywhere bat is reachable — direct calls, man pages, lessfilter.
export BAT_THEME="{{ zsh_bat_theme }}"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT="-c"

# delta as git's pager, configured through the environment so this role never
# has to own ~/.gitconfig. --navigate makes n/N step file-to-file in a large
# diff, which is the whole difference between reading a review and scrolling it.
export GIT_PAGER="delta {{ zsh_delta_options }}"
# Anything that pipes a diff by hand (`| D`, .lessfilter, `git diff | delta`)
# gets the same chrome without repeating the flags.
export DELTA_OPTS="{{ zsh_delta_options }}"

# difftastic (`gdt`) does its own colouring and only needs to be told which way
# round the background is; without this it assumes light and picks unreadable
# foregrounds on Macchiato.
export DFT_BACKGROUND=dark
export DFT_SYNTAX_HIGHLIGHT=on

# eza colours, Catppuccin Macchiato.
export EZA_COLORS="da=38;2;110;115;141:uu=38;2;110;115;141:gu=38;2;110;115;141:ur=38;2;198;160;246:uw=38;2;238;212;159:ux=38;2;166;218;149:sn=38;2;139;213;202:sb=38;2;110;115;141:xx=38;2;73;77;100:di=38;2;198;160;246"

# fzf: one accent (mauve), one surface, and Tab as the navigation key in every
# fzf there is — the shell's ^R/^T/Alt-C, the tms session pickers tmux opens in
# a window, forgit, fzf-tab's popup.
#
# `toggle+down`, not `down`: Tab's default job is toggling a selection, and
# rebinding it outright would silently break multi-select where it matters most
# (staging several files with `fa`). Toggle is a no-op in a single-select list,
# so a plain picker gets pure movement while a multi-select one gets the
# ranger-style "mark this, move on" that Tab is for. btab only moves — toggling
# on the way back up reads as undo but is not.
export FZF_DEFAULT_OPTS=" \
  --bind='tab:toggle+down,btab:up,ctrl-/:toggle-preview' \
  --layout=reverse --info=inline --border=none --pointer='▌' --marker='▌' \
  --color=bg+:#363a4f,fg:#cad3f5,fg+:#cad3f5,hl:{{ zsh_log_accent }},hl+:{{ zsh_log_accent }} \
  --color=pointer:{{ zsh_log_accent }},prompt:{{ zsh_log_accent }},marker:#a6da95,spinner:{{ zsh_log_accent }} \
  --color=info:#6e738d,header:#6e738d,gutter:-1,border:#363a4f"
export SKIM_DEFAULT_OPTIONS="--bind 'tab:down,shift-tab:up'"

## feh, sized to 80% of the focused monitor rather than to the image's own
## pixel size — a screenshot of a 4K screen otherwise opens larger than the
## screen it was taken on.
feh_scaled() {
  local width=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .width')
  local height=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .height')
  command feh --geometry $((width*80/100))x$((height*80/100)) --scale-down "$@"
}

