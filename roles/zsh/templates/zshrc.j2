{% endraw %}export LESS="-R"
typeset -U path cdpath fpath manpath
fpath+=(/usr/share/zsh/site-functions /usr/share/zsh/$ZSH_VERSION/functions /usr/share/zsh/vendor-completions)
HELPDIR="/usr/share/zsh/$ZSH_VERSION/help"

## Completion: compinit must run before plugins are sourced — fzf-tab and friends
## call `compdef` at load time, and `compdef` is defined by compinit.
autoload -Uz compinit && compinit -i

# ---------------- Plugin configuration --------------------------------------
# Anything a plugin reads at *load* time has to be set before it is sourced.
# forgit binds its own ga/gd/gi/gcf aliases on load and would shadow the git
# aliases below; the f-prefixed wrappers further down replace them.
export FORGIT_NO_ALIASES=1
export FORGIT_FZF_DEFAULT_OPTS="--height=90% --preview-window=right:60%"

# you-should-use prints the alias you could have typed, after the command has
# already run — a reminder, never a block, and quiet enough to ignore mid-flow.
export YSU_MESSAGE_POSITION=after
export YSU_MODE=BESTMATCH
export YSU_HARDCORE=0

# ---------------- Plugins (antidote) ----------------------------------------
# Static load file rendered from ~/.zsh_plugins.txt by the role. `antidote update`
# refreshes plugins; the role (or `antidote bundle < .zsh_plugins.txt > .zsh_plugins.zsh`)
# regenerates this file.
if [[ -f {{ zsh_plugins_static }} ]]; then
  source {{ zsh_plugins_static }}
fi

