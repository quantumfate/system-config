## Reading history. `gbl` ignores whitespace and follows code across files and
## commits — the difference between blaming the author and blaming whoever last
## ran the formatter. `gdt` diffs syntax trees, so reindentation shows as empty.
alias gbl='git blame -w -C -C -C'
alias gdt='git -c diff.external=difft diff'
alias gsh='git show'
alias grl='git reflog --date=relative'    # the undo log for everything above

## Branch hygiene: list branches whose commits are already in HEAD, then delete
## exactly those. Never touches the current branch or main/master.
gbclean() {
  local merged
  merged=(${(f)"$(git branch --merged | sed 's/^[* ] //' | grep -Ev '^(main|master|develop)$')"})
  (( $#merged )) || { print 'no merged branches'; return 0 }
  print -l -- $merged
  read -q "REPLY?delete these $#merged branches? [y/N] " || { print; return 1 }
  print; git branch -d $merged
}

## Repo root, for `cd $(groot)` or `groot`-relative paths in a deep tree.
groot() { cd "$(git rev-parse --show-toplevel)" }

