## which-key (Alt-h) — the cheatsheet as a picker, not a document.
##
## Every table row in roles/zsh/files/cheatsheet.md becomes one fzf line, tagged
## with its section. Sections are named after the program they drive, so the tag
## doubles as the search term. That file is the only source, so a binding cannot
## exist in the popup and not in the docs. Picking a row types the command.
##
## Each line is `section \t display`; --with-nth=2 shows the second field only,
## while matching stays on the whole line so a program name still narrows to its
## group. The tag is {1} in --preview, with no parsing needed.
_cheatsheet_rows() {
  [[ -r {{ zsh_cheatsheet }} ]] || return 1
  # Separator and header rows are dropped, markdown markers stripped. Padding
  # goes before colour: an escape counts toward printf's field width.
  awk '
    /^## / { section = substr($0, 4); next }
    /^\|/ {
      if ($0 ~ /^\|[ :-]*\|/) next
      # A description that is itself a pipeline escapes its pipe as \| in the
      # markdown; mask those before splitting, then put them back.
      line = $0
      gsub(/\\\|/, "\001", line)
      n = split(line, f, "|")
      if (n < 3) next
      keys = f[2]; desc = f[3]
      gsub(/\001/, "|", keys); gsub(/\001/, "|", desc)
      gsub(/`|\*\*/, "", keys); gsub(/`|\*\*/, "", desc)
      gsub(/^[ \t]+|[ \t]+$/, "", keys); gsub(/^[ \t]+|[ \t]+$/, "", desc)
      if (keys == "" || desc == "") next
      printf "%s\t\033[38;2;198;160;246m%-9s\033[0m %-30s \033[38;2;110;115;141m%s\033[0m\n", \
        section, section, keys, desc
    }
  ' {{ zsh_cheatsheet }}
}

## In tmux the popup keeps the prompt underneath from repainting; outside it the
## same fzf runs inline. Rows go in through a file and the choice comes back
## through one — a popup shares no stdin or stdout with this shell.
_cheatsheet_pick() {
  local out=$1 query=$2 rows=$3
  # The preview is the rest of the group — the question actually being asked.
  # --with-nth=2 hides the tag from the list, {1} still addresses it here.
  local -a fzf_args=(
    --ansi --no-sort --delimiter=$'\t' --with-nth=2
    --tiebreak=begin --prompt='which-key ❯ ' --query="$query"
    --preview="awk -F'\t' -v c={1} '\$1 == c' ${(q)rows} | cut -f2"
    --preview-window='right,46%,border-left,wrap'
    --header='enter: type it · esc: cancel · tab/S-tab: move'
    --height=100%
  )
  if [[ -z $TMUX ]]; then
    fzf "${fzf_args[@]}" < "$rows" > "$out"
    return
  fi
  # fzf directly, not under `zsh -ic`: that would re-source .zshrc on every
  # Alt-h. -e carries the fzf options in, since a popup is a child of the tmux
  # server and inherits nothing from this shell.
  #
  # (@q), not (q): a nested expansion joins the array first, so (q) would escape
  # the separators too and fzf would see one argument.
  tmux display-popup -E -w 88% -h 78% \
    -e "FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS" \
    "fzf ${(j: :)${(@q)fzf_args}} < ${(q)rows} > ${(q)out}"
}

cheatsheet-widget() {
  local tmp rows
  tmp=$(mktemp) || return
  rows=$(mktemp) || return
  _cheatsheet_rows > "$rows"
  # The word under the cursor seeds the query, so `g` + Alt-h opens on the git
  # rows. Split on whitespace, not (z): (z) parses the line as shell, and a
  # half-typed `echo it's g` would make one word of `it's g`.
  local seed=${LBUFFER##*[[:space:]]}
  _cheatsheet_pick "$tmp" "$seed" "$rows"
  local picked=$(<"$tmp"); command rm -f "$tmp" "$rows"
  zle reset-prompt
  [[ -n $picked ]] || return 0
  # The keys are the first word after the tab and the colours. extendedglob is
  # local: the `#` below is a glob operator only with it set, and setting it
  # globally changes how every other pattern in the shell parses.
  setopt localoptions extendedglob
  local display=${picked#*$'\t'}
  local plain=${display//$'\e'\[[0-9;]##m/}
  local key=${${=plain}[2]}
  # A tmux binding or zle chord has nothing to type.
  case $key in
    (C-b|C-*|^*|Esc|Alt-*|Tab|S-Tab|'<'|'>') return 0 ;;
  esac
  LBUFFER=${LBUFFER%$seed}$key
  zle redisplay
}
zle -N cheatsheet-widget
bindkey '^[h' cheatsheet-widget

