## zmv — batch rename by pattern: `mmv '(*).jpeg' '$1.jpg'`. -W makes the
## wildcards implicit capture groups; plain `zmv` takes explicit `(...)`/`$1`.
## -n on either shows what it would do.
autoload -Uz zmv
alias mmv='noglob zmv -W'   # rename by pattern
alias mcp='noglob zmv -W -C' # the same, copying
alias mln='noglob zmv -W -L' # the same, linking

## mkcd — create a directory and step into it.
mkcd() { mkdir -p -- "$1" && cd -- "$1" }

## bak — a timestamped copy beside the original.
bak() { for f in "$@"; do cp -a -- "$f" "$f.$(date +%Y%m%d%H%M%S).bak"; done }

## cheat — the useful half of a manpage.
