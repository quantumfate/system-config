## Shell options. Each removes a class of keystroke rather than adding a feature.
setopt AUTO_CD                 # `../src` is a cd
setopt AUTO_PUSHD              # every cd pushes the old dir — see `d`, 1..9
setopt PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt EXTENDED_GLOB           # ^, ~, #, and qualifiers: **/*.go~*_test.go(.)
setopt GLOB_DOTS               # dotfiles match without a leading .
setopt NUMERIC_GLOB_SORT       # log2 sorts before log10
setopt INTERACTIVE_COMMENTS    # # comments in an interactive line (pasted cmds)
setopt LONG_LIST_JOBS NOTIFY   # job state changes reported at once, in full
setopt NO_BEEP NO_FLOW_CONTROL # ^S/^Q are bindable keys, not terminal freezes
setopt MULTIOS                 # cmd >out >&2 — write to several targets at once

## vi mode for the line editor. `v` in normal mode round-trips the buffer
## through $EDITOR (the widget comes from zsh-edit).
set -o vi
export KEYTIMEOUT=10

# History substring search (vi-aware): j/k, ^P/^N.
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down
bindkey '^p' history-substring-search-up
bindkey '^n' history-substring-search-down

# vi insert mode drops the emacs editing keys. They are muscle memory while
# typing and the modal ones are still one Escape away, so put them back.
bindkey -M viins '^a' beginning-of-line
bindkey -M viins '^e' end-of-line
bindkey -M viins '^k' kill-line
bindkey -M viins '^u' backward-kill-line
bindkey -M viins '^w' backward-kill-word
bindkey -M viins '^y' yank
bindkey -M viins '^?' backward-delete-char   # backspace past the insert point
bindkey -M viins '^h' backward-delete-char

# Accept the autosuggestion without leaving the home row. ^F takes one word,
# for when the tail of the suggestion is wrong.
bindkey '^ ' autosuggest-accept
bindkey '^f' forward-word

# Search the history for what is already typed, in either mode.
bindkey -M vicmd '/' history-incremental-search-backward
bindkey -M vicmd '?' history-incremental-search-forward

# Ends of the buffer, not the line — for heredocs and long pipelines.
bindkey -M vicmd 'gg' beginning-of-buffer-or-history
bindkey -M vicmd 'G' end-of-buffer-or-history

## `v` opens the line in $EDITOR and runs it on save — the escape hatch for a
## command that outgrew one line. Replaces visual-mode; `V` still does that.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

## Alt-. cycles the last word of each previous command; Alt-m takes the word
## above the cursor.
bindkey -M viins '^[.' insert-last-word
bindkey -M viins '^[m' copy-prev-shell-word

## Completion: fzf-tab.
zstyle ':completion:*' menu no
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' fzf-flags --bind=tab:down,shift-tab:up,enter:accept,right:accept
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
# ftb-tmux-popup sizes itself to the content, so a short list gets a popup too
# narrow to read. popup-min-size is the floor, popup-pad buys room for the group
# column and preview. (`popup-min-width` is not a real style, it is ignored.)
zstyle ':fzf-tab:*' popup-min-size 100 25
zstyle ':fzf-tab:*' popup-pad 30 0
zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview 'SYSTEMD_COLORS=1 systemctl status $word'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' fzf-tab-group-order alias directory file command 'external command'

# fzf keys: ^T file, ^R history, Alt-C cd. After compinit, so its completions
# register.
[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]]   && source /usr/share/fzf/completion.zsh

# First run on a fresh machine: .zshrc exists, the plugin clones do not yet.
(( $+functions[zsh-defer] )) || zsh-defer() { [[ $1 == -c ]] && shift; eval "$@" }

## Slow initialisers, run after the first prompt paints. The `-c` form matters:
## without it the $(...) is still substituted now.
zsh-defer -c 'eval "$(zoxide init zsh)"'          # `z` — jump by frecency
zsh-defer -c 'eval "$(thefuck --alias)"'          # `fuck` — fix the last command
zsh-defer -c 'eval "$(direnv hook zsh)"'          # per-directory env on cd

## ---------------------------------------------------------------------------
## Prompt. Three rows: blank, a dim context row, then the input row.
##
## Context goes above the input rather than in an RPROMPT, which a long command
## overwrites — losing exactly what you wanted during a long pipeline. The row
## is dim; colour is only spent on meaning (red failed, yellow dirty, green
## staged).
##
## Everything is computed in precmd, two forks at most, no framework.
zmodload zsh/datetime   # $EPOCHREALTIME — a parameter, so no `date` fork
zmodload zsh/parameter  # $jobstates — the job table, without forking `jobs`
autoload -Uz add-zsh-hook

# Palette, named once so the segments below read as intent.
typeset -gA _p=(
  text    '#cad3f5'  dim     '#6e738d'  faint '#5b6078'
  mauve   '#c6a0f6'  blue    '#8aadf4'  green '#a6da95'
  yellow  '#eed49f'  peach   '#f5a97f'  red   '#ed8796'
  teal    '#8bd5ca'  flamingo '#f0c6c6'
)

## --- git ---------------------------------------------------------------------
## One `status --porcelain=v2 --branch` answers all of it: branch, divergence,
## and the staged/modified/conflicted/untracked counts. vcs_info wanted four or
## five forks for strictly less.
##
## --no-optional-locks: never rewrite the index behind an editor or another pane.
typeset -gA _p_repo=()
_prompt_repo() {
  # Neither path can change while $PWD does not, so ask once per directory. A
  # directory outside any repo caches the empty string just as usefully.
  if [[ -z ${_p_repo[$PWD]+x} ]]; then
    _p_repo[$PWD]=${(pj:\n:)${(f)"$(git rev-parse --absolute-git-dir --show-toplevel 2>/dev/null)"}}
  fi
  print -r -- $_p_repo[$PWD]
}
_prompt_repo_flush() { _p_repo=() }
add-zsh-hook chpwd _prompt_repo_flush

_prompt_git() {
  _PROMPT_GIT=''
  local gitdir=${${(f)"$(_prompt_repo)"}[1]}
  [[ -n $gitdir ]] || return

  local -a out
  out=(${(f)"$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)"})
  (( $#out )) || return

  local head='' ahead=0 behind=0
  local -i staged=0 dirty=0 conflict=0 untracked=0
  local line
  for line in $out; do
    case $line in
      '# branch.head '*) head=${line#\# branch.head } ;;
      '# branch.ab '*)
        local ab=${line#\# branch.ab }
        ahead=${${ab%% *}#+} behind=${${ab##* }#-}
        ;;
      # "1 XY ..." / "2 XY ..." — X staged, Y worktree. A path can be both, and
      # counting it twice is right: two separate pieces of work.
      [12]' '*)
        local xy=${line[3,4]}
        [[ ${xy[1]} != '.' ]] && (( staged++ ))
        [[ ${xy[2]} != '.' ]] && (( dirty++ ))
        ;;
      'u '*) (( conflict++ )) ;;
      '? '*) (( untracked++ )) ;;
    esac
  done

  # Detached HEAD: the short oid, marked, so it never reads as a branch.
  [[ $head == '(detached)' ]] && head="@${$(git rev-parse --short HEAD 2>/dev/null)}"

  # An interrupted operation outranks the rest of the row: until it is finished
  # or aborted, no other git command does what you expect.
  local action=''
  if [[ -d $gitdir/rebase-merge ]]; then
    action="rebase ${$(<$gitdir/rebase-merge/msgnum 2>/dev/null)}/${$(<$gitdir/rebase-merge/end 2>/dev/null)}"
  elif [[ -d $gitdir/rebase-apply ]]; then
    action=rebase
  elif [[ -f $gitdir/MERGE_HEAD ]]; then
    action=merge
  elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then
    action=cherry-pick
  elif [[ -f $gitdir/BISECT_LOG ]]; then
    action=bisect
  fi

  local seg="%F{$_p[blue]}$head%f"
  [[ -n $action ]]     && seg+=" %F{$_p[peach]}$action%f"
  (( ahead ))          && seg+=" %F{$_p[teal]}⇡$ahead%f"
  (( behind ))         && seg+=" %F{$_p[teal]}⇣$behind%f"
  (( staged ))         && seg+=" %F{$_p[green]}+$staged%f"
  (( dirty ))          && seg+=" %F{$_p[yellow]}!$dirty%f"
  (( untracked ))      && seg+=" %F{$_p[dim]}?$untracked%f"
  (( conflict ))       && seg+=" %F{$_p[red]}✗$conflict%f"
  _PROMPT_GIT=$seg
}

## --- how long the last command took ------------------------------------------
## Under 3s it did not cost a context switch, so it is not printed.
_prompt_timer_start() { _p_t0=$EPOCHREALTIME }
_prompt_timer_stop() {
  _PROMPT_TIME=''
  [[ -n $_p_t0 ]] || return
  local -F elapsed=$(( EPOCHREALTIME - _p_t0 ))
  unset _p_t0
  (( elapsed < 3 )) && return
  if (( elapsed >= 3600 )); then
    _PROMPT_TIME=$(printf '%dh%02dm' $(( elapsed / 3600 )) $(( (elapsed % 3600) / 60 )))
  elif (( elapsed >= 60 )); then
    _PROMPT_TIME=$(printf '%dm%02ds' $(( elapsed / 60 )) $(( elapsed % 60 )))
  else
    # Without LC_NUMERIC the separator follows the locale: "3,2s" in de_DE.
    _PROMPT_TIME=$(LC_NUMERIC=C printf '%.1fs' $elapsed)
  fi
}
add-zsh-hook preexec _prompt_timer_start

## --- where you are -----------------------------------------------------------
## Long paths abbreviate their components instead of collapsing them into an
## ellipsis: `~/P/c/q/system-config` keeps the shape of the path where `~/…/`
## throws it away. Two parts stay spelled out — the last one, and the repo root,
## which is bold so "which project" needs no parsing.
_prompt_path() {
  local -a parts=(${(s:/:)${(D)PWD}})
  local lead=''
  [[ ${(D)PWD} == /* ]] && lead='/'

  # The repo root's position in the path, so it can be exempted from shortening.
  local root=${${(f)"$(_prompt_repo)"}[2]}
  local -i rootidx=0
  [[ -n $root ]] && rootidx=${#${(s:/:)${(D)root}}}

  local -i i keep=2 n=$#parts
  for (( i = 1; i <= n - keep; i++ )); do
    (( i == rootidx )) && continue
    [[ $parts[i] == '~'* ]] && continue          # ~ and ~named are already short
    # A leading dot carries no identity, so .config shortens to .c.
    [[ $parts[i] == .* ]] && parts[i]=${parts[i][1,2]} || parts[i]=${parts[i][1,1]}
  done

  # Dim for the abbreviated head, bright for what is spelled out.
  local out=''
  for (( i = 1; i <= n; i++ )); do
    if (( i == rootidx )); then
      out+="%F{$_p[text]}%B$parts[i]%b%f"
    elif (( i > n - keep )); then
      out+="%F{$_p[text]}$parts[i]%f"
    else
      out+="%F{$_p[dim]}$parts[i]%f"
    fi
    (( i < n )) && out+="%F{$_p[faint]}/%f"
  done
  print -r -- "$lead$out"
}

## --- the context row ---------------------------------------------------------
## Ordered by how often a segment changes the next keystroke. Everything after
## the cwd is conditional: a clean repo-less directory prints one path.
_prompt_context() {
  local -i last=$_p_status
  local -a seg

  # Identity only when it is not the obvious one — ssh or root.
  if [[ -n $SSH_CONNECTION ]]; then
    seg+="%F{$_p[peach]}%n@%m%f"
  elif (( EUID == 0 )); then
    seg+="%F{$_p[red]}%B root %b%f"
  fi

  seg+=$(_prompt_path)

  [[ -n $_PROMPT_GIT ]] && seg+=$_PROMPT_GIT

  # auto_venv activates venvs on cd, so the prompt has to say which one.
  if [[ -n $VIRTUAL_ENV ]]; then
    local venv=${VIRTUAL_ENV:t}
    [[ $venv == (.venv|venv|env) ]] && venv=${VIRTUAL_ENV:h:t}
    seg+="%F{$_p[flamingo]}$venv%f"
  fi
  # direnv loaded something: this is not the environment in .zshrc.
  [[ -n $DIRENV_DIR ]] && seg+="%F{$_p[flamingo]}env%f"

  # Counted, not tested with %(1j.): that would add an empty field to the join
  # and leave trailing whitespace on the row.
  (( $#jobstates )) && seg+="%F{$_p[yellow]}$#jobstates&%f"

  [[ -n $_PROMPT_TIME ]] && seg+="%F{$_p[dim]}$_PROMPT_TIME%f"
  # 130 is a ^C, dimmed — you meant that one.
  if (( last )); then
    if (( last == 130 )); then
      seg+="%F{$_p[dim]}^C%f"
    else
      seg+="%F{$_p[red]}✗$last%f"
    fi
  fi

  # Two spaces read as separate fields without needing a separator glyph.
  print -r -- ${(j:  :)seg}
}

## --- vi mode -----------------------------------------------------------------
## The mode lives in the chevron, where the cursor already is — not in a word on
## the far right, which you would have to look away to read. Shape carries it,
## colour confirms: ❯ insert, ❮ normal. The cursor changes with it, as in nvim.
_prompt_mode() {
  case $KEYMAP in
    vicmd)  _PROMPT_CHAR="%F{$_p[blue]}❮%f";  print -n '\e[2 q' ;;  # block
    *)      _PROMPT_CHAR="%F{$_p[mauve]}❯%f"; print -n '\e[6 q' ;;  # beam
  esac
}
zle-keymap-select() { _prompt_mode; zle reset-prompt }
zle-line-init()     { _prompt_mode; zle reset-prompt }
zle -N zle-keymap-select
zle -N zle-line-init
# Hand a block cursor back to whatever runs next.
_prompt_cursor_reset() { print -n '\e[2 q' }
add-zsh-hook preexec _prompt_cursor_reset

## --- assembly ----------------------------------------------------------------
## $? first: any command in a later hook would clobber it.
_prompt_precmd() {
  _p_status=$?
  _prompt_timer_stop
  _prompt_git
  _PROMPT_INFO=$(_prompt_context)
  _PROMPT_CHAR="%F{$_p[mauve]}❯%f"
}
add-zsh-hook precmd _prompt_precmd

setopt PROMPT_SUBST
PROMPT='
${_PROMPT_INFO}
${_PROMPT_CHAR} '
# Nothing on the right — the context row above already has the full width.
RPROMPT=''
{% endraw %}
## History — shared, deduped, persisted, locked against concurrent shells.
HISTSIZE="{{ zsh_history_size }}"
SAVEHIST="{{ zsh_history_size }}"
HISTFILE="{{ zsh_history_file }}"
mkdir -p "$(dirname "$HISTFILE")"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
unsetopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS \
  HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

## Auto-workflows on directory change.
function auto_venv() {
  if [[ -n "$VIRTUAL_ENV" && "$PWD" != *"${VIRTUAL_ENV:h}"* ]]; then
    deactivate; return
  fi
  [[ -n "$VIRTUAL_ENV" ]] && return
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.venv/bin/activate" ]]; then source "$dir/.venv/bin/activate"; return; fi
    dir="${dir:h}"
  done
}
function auto_nvm() { [[ -f .nvmrc ]] && nvm use }
add-zsh-hook chpwd auto_venv
add-zsh-hook chpwd auto_nvm
[[ -n "$TMUX" ]] && auto_venv
[[ -n "$TMUX" ]] && auto_nvm

## `ya` opens yazi, then cds to wherever you left it and tells zoxide.
ya() {
  local tmp="$(mktemp)"
  yazi "$@" --cwd-file="$tmp"
  if [[ -s "$tmp" ]]; then
    local cwd="$(cat "$tmp")"
    builtin cd -- "$cwd" && zoxide add -- "$cwd"
  fi
  rm -f "$tmp"
}

