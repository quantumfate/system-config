## `gbl` ignores whitespace and follows code across files, so it blames the
## author and not the formatter. `gdt` diffs syntax trees: a reindent is empty.
alias gbl='git blame -w -C -C -C'
alias gdt='git -c diff.external=difft diff'
alias gsh='git show'
alias grl='git reflog --date=relative'    # the undo log for everything above

## Searches
# Files and Directories
alias ffn='find . -type f -name'
alias fdn='find . -type d -name'
# Find files recently modified in the past i days
for i in {1..9}; do alias "fft$i"="find . -type f -mtime -$i"; done; unset i
for i in {1..9}; do alias "fdt$i"="find . -type d -mtime -$i"; done; unset i
# Find files recently modified longer than i days
for i in {1..9}; do alias "fft$i"="find . -type f -mtime +$i"; done; unset i
for i in {1..9}; do alias "fdt$i"="find . -type d -mtime +$i"; done; unset i

## Delete the branches already merged into HEAD. Never main/master or the
## current branch.
gbclean() {
  local merged
  merged=(${(f)"$(git branch --merged | sed 's/^[* ] //' | grep -Ev '^(main|master|develop)$')"})
  (( $#merged )) || { print 'no merged branches'; return 0 }
  print -l -- $merged
  read -q "REPLY?delete these $#merged branches? [y/N] " || { print; return 1 }
  print; git branch -d $merged
}

## Repo root, for `cd $(groot)` or `groot`-relative paths in a deep tree.
groot() { cd "$(git rev-parse --show-toplevel)" }

