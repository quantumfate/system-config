## mkcd — create a directory and step into it. The two halves of the same act.
mkcd() { mkdir -p -- "$1" && cd -- "$1" }

## bak — a timestamped copy beside the original, before you edit it in anger.
bak() { for f in "$@"; do cp -a -- "$f" "$f.$(date +%Y%m%d%H%M%S).bak"; done }

