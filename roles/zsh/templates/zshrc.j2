## Shell options. Each one removes a class of keystroke rather than adding a
## feature: `cd` becomes optional, every directory you visit stays reachable by
## number, and globs stop needing `find`.
setopt AUTO_CD                 # `../src` is a cd
setopt AUTO_PUSHD              # every cd pushes the old dir — see `d`, 1..9
setopt PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt EXTENDED_GLOB           # ^, ~, #, and qualifiers: **/*.go~*_test.go(.)
setopt GLOB_DOTS               # dotfiles match without a leading .
setopt NUMERIC_GLOB_SORT       # log2 sorts before log10
setopt INTERACTIVE_COMMENTS    # # comments in an interactive line (pasted cmds)
setopt LONG_LIST_JOBS NOTIFY   # job state changes reported at once, in full
setopt NO_BEEP NO_FLOW_CONTROL # ^S/^Q are bindable keys, not terminal freezes
setopt MULTIOS                 # cmd >out >&2 — write to several targets at once

## vi mode: the whole line editor speaks nvim. hjkl, b/f/w, ciw, dd, and `v`
## in normal mode opens the buffer in $EDITOR (nvim) for a full round-trip.
## (zsh-edit provides the improved nvim edit widget; `^X^E` and `v` trigger it.)
set -o vi
export KEYTIMEOUT=10

# History substring search (vi-aware): j/k, ^P/^N.
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down
bindkey '^p' history-substring-search-up
bindkey '^n' history-substring-search-down

# vi insert mode drops every emacs editing key, which is the one place vi mode
# is a straight downgrade: those keys are muscle memory *while typing*, and the
# modal keys live one Escape away regardless. Put the useful ones back.
bindkey -M viins '^a' beginning-of-line
bindkey -M viins '^e' end-of-line
bindkey -M viins '^k' kill-line
bindkey -M viins '^u' backward-kill-line
bindkey -M viins '^w' backward-kill-word
bindkey -M viins '^y' yank
bindkey -M viins '^?' backward-delete-char   # backspace past the insert point
bindkey -M viins '^h' backward-delete-char

# Accept the autosuggestion with ^Space. The default (right-arrow / End) means
# leaving the home row for the single most frequent completion there is; ^F
# takes the next word only, for when the tail of the suggestion is wrong.
bindkey '^ ' autosuggest-accept
bindkey '^f' forward-word

# Search the history for what is already typed, in either mode.
bindkey -M vicmd '/' history-incremental-search-backward
bindkey -M vicmd '?' history-incremental-search-forward

# In vicmd, jump to the ends of the *buffer*, not the line — multi-line commands
# (a heredoc, a long pipeline) are where this matters.
bindkey -M vicmd 'gg' beginning-of-buffer-or-history
bindkey -M vicmd 'G' end-of-buffer-or-history

## Completion: fzf-tab.
zstyle ':completion:*' menu no
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' fzf-flags --bind=tab:down,shift-tab:up,enter:accept,right:accept
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
# Popup size. ftb-tmux-popup sizes itself to the *content*:
#   width  = min(max(longest candidate + 5 + pad, min-width),  window width)
#   height = min(max(line count   + 4 + pad, min-height), room above the cursor)
# so without a floor a short list gets a popup too narrow to read — the names
# truncate to "browse··" and the group column eats what is left. `popup-pad`
# buys room for the group column and the preview; `popup-min-size` is the floor.
# (`popup-min-width` is not a real style — fzf-tab ignored it silently.)
zstyle ':fzf-tab:*' popup-min-size 100 25
zstyle ':fzf-tab:*' popup-pad 30 0
zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview 'SYSTEMD_COLORS=1 systemctl status $word'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' fzf-tab-group-order alias directory file command 'external command'

# fzf keybindings + completion (^T file, ^R history, Alt-C cd). Needs
# $FZF_DEFAULT_OPTS (below) set first, so they load later; sourced here after
# compinit so the completions they provide are registered.
[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]]   && source /usr/share/fzf/completion.zsh

# Fallback for the first run of a fresh machine, where .zshrc exists but the
# plugin clones do not yet: run the command now rather than dropping it on the
# floor with a "command not found".
(( $+functions[zsh-defer] )) || zsh-defer() { [[ $1 == -c ]] && shift; eval "$@" }

## Slow initialisers, deferred. zsh-defer queues these to run after the first
## prompt is painted, so an interactive shell is usable immediately instead of
## waiting on a python start-up (thefuck) and three subprocesses. The `-c` form
## matters: without it the $(...) would still be substituted *now*.
zsh-defer -c 'eval "$(zoxide init zsh)"'          # `z` — jump by frecency
zsh-defer -c 'eval "$(thefuck --alias)"'          # `fuck` — fix the last command
zsh-defer -c 'eval "$(direnv hook zsh)"'          # per-directory env on cd

## ---------------------------------------------------------------------------
## Prompt. Three rows: a blank one, a dim context row, and the input row.
##
## The shape is the point. A right-hand RPROMPT on a one-line prompt is a trap —
## a long command overwrites it, so the information you most want during a long
## pipeline is exactly the information that disappears. Moving context *above*
## the input gives it the full terminal width, leaves the command a clean line
## that always starts at column 3, and puts the blank row where every other
## surface here puts one (tmux's empty status row, kitty's padding).
##
## The context row is dim on purpose: it is reference material, glanced at, not
## read. Only the cwd is at full text brightness, and only the chevron is
## accented — the rest earns colour solely by meaning something (red failed,
## yellow dirty, green staged).
##
## Everything is computed in precmd from two forks at most, never a subshell in
## the prompt string itself. No prompt framework, no dependency.
zmodload zsh/datetime   # $EPOCHREALTIME — a parameter, so no `date` fork
zmodload zsh/parameter  # $jobstates — the job table, without forking `jobs`
autoload -Uz add-zsh-hook

# Palette, named once so the segments below read as intent rather than hex.
typeset -gA _p=(
  text    '#cad3f5'  dim     '#6e738d'  faint '#5b6078'
  mauve   '#c6a0f6'  blue    '#8aadf4'  green '#a6da95'
  yellow  '#eed49f'  peach   '#f5a97f'  red   '#ed8796'
  teal    '#8bd5ca'  flamingo '#f0c6c6'
)

## --- git ---------------------------------------------------------------------
## One `git status --porcelain=v2 --branch` call answers everything the prompt
## asks: branch, upstream divergence, and how many paths are staged, modified,
## conflicted or untracked. vcs_info needed four or five forks for strictly less
## (it has no ahead/behind and no counts), which is why it is gone.
##
## --no-optional-locks keeps the prompt from refreshing (and rewriting) the index
## behind a running editor or a git command in another pane.
typeset -gA _p_repo=()
_prompt_repo() {
  # Neither the git dir nor the toplevel can change while $PWD does not, so ask
  # once per directory and answer from the cache after that. One fork returns
  # both. A directory outside any repo caches the empty string just as usefully.
  if [[ -z ${_p_repo[$PWD]+x} ]]; then
    _p_repo[$PWD]=${(pj:\n:)${(f)"$(git rev-parse --absolute-git-dir --show-toplevel 2>/dev/null)"}}
  fi
  print -r -- $_p_repo[$PWD]
}
_prompt_repo_flush() { _p_repo=() }
add-zsh-hook chpwd _prompt_repo_flush

_prompt_git() {
  _PROMPT_GIT=''
  local gitdir=${${(f)"$(_prompt_repo)"}[1]}
  [[ -n $gitdir ]] || return

  local -a out
  out=(${(f)"$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)"})
  (( $#out )) || return

  local head='' ahead=0 behind=0
  local -i staged=0 dirty=0 conflict=0 untracked=0
  local line
  for line in $out; do
    case $line in
      '# branch.head '*) head=${line#\# branch.head } ;;
      '# branch.ab '*)
        local ab=${line#\# branch.ab }
        ahead=${${ab%% *}#+} behind=${${ab##* }#-}
        ;;
      # "1 XY ..." / "2 XY ..." — X is the staged column, Y the worktree column.
      # A path can be both, and counting it twice is correct: they are two
      # different pieces of work you still have to do.
      [12]' '*)
        local xy=${line[3,4]}
        [[ ${xy[1]} != '.' ]] && (( staged++ ))
        [[ ${xy[2]} != '.' ]] && (( dirty++ ))
        ;;
      'u '*) (( conflict++ )) ;;
      '? '*) (( untracked++ )) ;;
    esac
  done

  # Detached HEAD: show the short oid, marked, so it never reads as a branch.
  [[ $head == '(detached)' ]] && head="@${$(git rev-parse --short HEAD 2>/dev/null)}"

  # An interrupted operation outranks everything else on the row: until it is
  # finished or aborted, no other git command will do what you expect.
  local action=''
  if [[ -d $gitdir/rebase-merge ]]; then
    action="rebase ${$(<$gitdir/rebase-merge/msgnum 2>/dev/null)}/${$(<$gitdir/rebase-merge/end 2>/dev/null)}"
  elif [[ -d $gitdir/rebase-apply ]]; then
    action=rebase
  elif [[ -f $gitdir/MERGE_HEAD ]]; then
    action=merge
  elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then
    action=cherry-pick
  elif [[ -f $gitdir/BISECT_LOG ]]; then
    action=bisect
  fi

  local seg="%F{$_p[blue]}$head%f"
  [[ -n $action ]]     && seg+=" %F{$_p[peach]}$action%f"
  (( ahead ))          && seg+=" %F{$_p[teal]}⇡$ahead%f"
  (( behind ))         && seg+=" %F{$_p[teal]}⇣$behind%f"
  (( staged ))         && seg+=" %F{$_p[green]}+$staged%f"
  (( dirty ))          && seg+=" %F{$_p[yellow]}!$dirty%f"
  (( untracked ))      && seg+=" %F{$_p[dim]}?$untracked%f"
  (( conflict ))       && seg+=" %F{$_p[red]}✗$conflict%f"
  _PROMPT_GIT=$seg
}

## --- how long the last command took ------------------------------------------
## Wall time is only interesting once it is long enough to have cost you the
## context switch, so nothing under 3s is printed. $EPOCHREALTIME is a parameter,
## not a `date` fork.
_prompt_timer_start() { _p_t0=$EPOCHREALTIME }
_prompt_timer_stop() {
  _PROMPT_TIME=''
  [[ -n $_p_t0 ]] || return
  local -F elapsed=$(( EPOCHREALTIME - _p_t0 ))
  unset _p_t0
  (( elapsed < 3 )) && return
  if (( elapsed >= 3600 )); then
    _PROMPT_TIME=$(printf '%dh%02dm' $(( elapsed / 3600 )) $(( (elapsed % 3600) / 60 )))
  elif (( elapsed >= 60 )); then
    _PROMPT_TIME=$(printf '%dm%02ds' $(( elapsed / 60 )) $(( elapsed % 60 )))
  else
    # LC_NUMERIC or the separator follows the locale: "3,2s" in de_DE.
    _PROMPT_TIME=$(LC_NUMERIC=C printf '%.1fs' $elapsed)
  fi
}
add-zsh-hook preexec _prompt_timer_start

## --- where you are -----------------------------------------------------------
## Long paths are shortened by *abbreviating* the components you already know,
## never by replacing them with an ellipsis. `~/…/quantumfate/system-config` is
## shorter but it is also a worse answer: it throws away which tree you are in
## and gives back a character that means "something was here". `~/P/c/q/…`
## keeps the shape of the path, stays sortable by eye, and is still unambiguous
## in practice — you know your own directories by their first letter.
##
## Two components are always spelled out in full: the last one, and the root of
## the repo you are in. Those are the two names you actually read. The repo root
## is bold, so "which project" is answerable without parsing the path at all.
_prompt_path() {
  local -a parts=(${(s:/:)${(D)PWD}})
  local lead=''
  [[ ${(D)PWD} == /* ]] && lead='/'

  # The repo root's position in the path, so it can be exempted from shortening.
  local root=${${(f)"$(_prompt_repo)"}[2]}
  local -i rootidx=0
  [[ -n $root ]] && rootidx=${#${(s:/:)${(D)root}}}

  local -i i keep=2 n=$#parts
  for (( i = 1; i <= n - keep; i++ )); do
    (( i == rootidx )) && continue
    [[ $parts[i] == '~'* ]] && continue          # ~ and ~named are already short
    # A leading dot carries no identity on its own, so .config shortens to .c.
    [[ $parts[i] == .* ]] && parts[i]=${parts[i][1,2]} || parts[i]=${parts[i][1,1]}
  done

  # Dim for the abbreviated head, full brightness for what is spelled out.
  local out=''
  for (( i = 1; i <= n; i++ )); do
    if (( i == rootidx )); then
      out+="%F{$_p[text]}%B$parts[i]%b%f"
    elif (( i > n - keep )); then
      out+="%F{$_p[text]}$parts[i]%f"
    else
      out+="%F{$_p[dim]}$parts[i]%f"
    fi
    (( i < n )) && out+="%F{$_p[faint]}/%f"
  done
  print -r -- "$lead$out"
}

## --- the context row ---------------------------------------------------------
## Order is by how often it changes your next keystroke: where you are, what the
## repo is doing, what environment is active, what is still running, and how the
## last command ended. Every segment after the cwd is conditional — an empty
## repo-less directory with a clean exit prints one path and nothing else.
_prompt_context() {
  local -i last=$_p_status
  local -a seg

  # Identity, but only when it is not the obvious one. On your own machine as
  # yourself this is noise; over ssh or as root it is the whole story.
  if [[ -n $SSH_CONNECTION ]]; then
    seg+="%F{$_p[peach]}%n@%m%f"
  elif (( EUID == 0 )); then
    seg+="%F{$_p[red]}%B root %b%f"
  fi

  seg+=$(_prompt_path)

  [[ -n $_PROMPT_GIT ]] && seg+=$_PROMPT_GIT

  # The shell activates venvs on cd (auto_venv); a prompt that does not say so
  # leaves you guessing which python `python` is.
  if [[ -n $VIRTUAL_ENV ]]; then
    local venv=${VIRTUAL_ENV:t}
    [[ $venv == (.venv|venv|env) ]] && venv=${VIRTUAL_ENV:h:t}
    seg+="%F{$_p[flamingo]}$venv%f"
  fi
  # direnv loaded something here: the environment is not the one in .zshrc.
  [[ -n $DIRENV_DIR ]] && seg+="%F{$_p[flamingo]}env%f"

  # Background jobs are easy to forget and expensive to lose. Counted rather
  # than tested with %(1j.), which would still contribute an empty field to the
  # join below and leave the row with trailing whitespace.
  (( $#jobstates )) && seg+="%F{$_p[yellow]}$#jobstates&%f"

  [[ -n $_PROMPT_TIME ]] && seg+="%F{$_p[dim]}$_PROMPT_TIME%f"
  # The failure sits directly above the next prompt and directly below the
  # output that explains it. 130 is a ^C and is dimmed: you meant that one.
  if (( last )); then
    if (( last == 130 )); then
      seg+="%F{$_p[dim]}^C%f"
    else
      seg+="%F{$_p[red]}✗$last%f"
    fi
  fi

  # Two spaces between segments: enough to read as separate fields without
  # needing a separator glyph to say so.
  print -r -- ${(j:  :)seg}
}

## --- vi mode -----------------------------------------------------------------
## The mode lives in the chevron, where the cursor already is. A word ("NORMAL")
## on the far right of the line is the wrong place to say something you need to
## know before you press the next key — you would have to look away from the
## text you are editing to read it.
##
## Shape carries it, colour confirms it: ❯ insert (mauve), ❮ normal (blue). The
## cursor changes with it, the way it does in nvim, so the two halves of the
## editing surface agree.
_prompt_mode() {
  case $KEYMAP in
    vicmd)  _PROMPT_CHAR="%F{$_p[blue]}❮%f";  print -n '\e[2 q' ;;  # block
    *)      _PROMPT_CHAR="%F{$_p[mauve]}❯%f"; print -n '\e[6 q' ;;  # beam
  esac
}
zle-keymap-select() { _prompt_mode; zle reset-prompt }
zle-line-init()     { _prompt_mode; zle reset-prompt }
zle -N zle-keymap-select
zle -N zle-line-init
# Hand a normal block cursor back to whatever runs next; a beam is a line-editor
# convention and nvim/less will set their own anyway.
_prompt_cursor_reset() { print -n '\e[2 q' }
add-zsh-hook preexec _prompt_cursor_reset

## --- assembly ----------------------------------------------------------------
## precmd captures $? first (any command run inside a later hook would clobber
## it), then fills the three variables the prompt string interpolates.
_prompt_precmd() {
  _p_status=$?
  _prompt_timer_stop
  _prompt_git
  _PROMPT_INFO=$(_prompt_context)
  _PROMPT_CHAR="%F{$_p[mauve]}❯%f"
}
add-zsh-hook precmd _prompt_precmd

setopt PROMPT_SUBST
PROMPT='
${_PROMPT_INFO}
${_PROMPT_CHAR} '
# Nothing on the right. The context row above already has the full width, and
# an RPROMPT would only be there to be overwritten by a long command line.
RPROMPT=''
{% endraw %}
## History — shared, deduped, persisted, locked against concurrent shells.
HISTSIZE="{{ zsh_history_size }}"
SAVEHIST="{{ zsh_history_size }}"
HISTFILE="{{ zsh_history_file }}"
mkdir -p "$(dirname "$HISTFILE")"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
unsetopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS \
  HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

## Auto-workflows on directory change.
function auto_venv() {
  if [[ -n "$VIRTUAL_ENV" && "$PWD" != *"${VIRTUAL_ENV:h}"* ]]; then
    deactivate; return
  fi
  [[ -n "$VIRTUAL_ENV" ]] && return
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.venv/bin/activate" ]]; then source "$dir/.venv/bin/activate"; return; fi
    dir="${dir:h}"
  done
}
function auto_nvm() { [[ -f .nvmrc ]] && nvm use }
add-zsh-hook chpwd auto_venv
add-zsh-hook chpwd auto_nvm
[[ -n "$TMUX" ]] && auto_venv
[[ -n "$TMUX" ]] && auto_nvm

## File manager: yazi as the primary — `ya` opens yazi, then cds into whatever
## directory you left it in and records it in zoxide for `z` jumps.
ya() {
  local tmp="$(mktemp)"
  yazi "$@" --cwd-file="$tmp"
  if [[ -s "$tmp" ]]; then
    local cwd="$(cat "$tmp")"
    builtin cd -- "$cwd" && zoxide add -- "$cwd"
  fi
  rm -f "$tmp"
}

