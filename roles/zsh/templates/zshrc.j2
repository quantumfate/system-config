alias fct='forgit::checkout::tag'   # same, for tags
alias fbd='forgit::branch::delete'  # delete branches, seeing what is on them first
alias ffx='forgit::fixup'           # pick the commit to fix up, instead of gfx <sha>
alias fsq='forgit::squash'          # pick the commit to squash into
