# ~/.config/tailspin/theme.toml — rendered by roles/zsh.
#
# Three things in a log line get a colour — when, how bad, and what. The rest is
# structure and stays uncoloured.
#
# tspin takes only the 16 ANSI names, which the kitty palette already defines as
# Macchiato: `red` IS #ed8796, `blue` IS #8aadf4.
#
#   ANSI name       Macchiato       used for
#   red             #ed8796         error / fatal
#   yellow          #eed49f         warn
#   green           #a6da95         ok / success
#   blue            #8aadf4         info, timestamps
#   magenta         #f5bde6         date part
#   cyan            #8bd5ca         numbers, ids
#   bright_black    #5b6078         separators, structure

# Timestamps anchor the column, so they stay dim.
[dates]
date = { fg = "bright_black" }
time = { fg = "blue" }
zone = { fg = "bright_black" }
separator = { faint = true }

# A PID is not an event.
[numbers]
style = { fg = "cyan", faint = true }

[key_value_pairs]
key = { faint = true }
separator = { faint = true }

[json]
key = { faint = true }
quote_token = { faint = true }
curly_bracket = { faint = true }
square_bracket = { faint = true }
comma = { faint = true }
colon = { faint = true }

[quotes]
quote_token = '"'
style = { fg = "green" }

[paths]
segment = { faint = true }
separator = { faint = true }

[processes]
name = { fg = "bright_black" }
id = { fg = "bright_black", faint = true }
bracket = { faint = true }

# --- Severity ---------------------------------------------------------------
# Colour carries the level; bold is only for "drop everything". A page of bold
# red reads no better than no colour at all. Syslog and journald spellings both.
[[keywords]]
words = ["FATAL", "fatal", "PANIC", "panic", "CRITICAL", "critical", "CRIT", "EMERG", "emerg", "ALERT", "alert"]
style = { fg = "red", bold = true }

[[keywords]]
words = ["ERROR", "error", "ERR", "err", "FAIL", "Failed", "failed", "failure"]
style = { fg = "red" }

[[keywords]]
words = ["WARN", "warn", "WARNING", "warning"]
style = { fg = "yellow" }

[[keywords]]
words = ["INFO", "info", "NOTICE", "notice"]
style = { fg = "blue" }

[[keywords]]
words = ["DEBUG", "debug", "TRACE", "trace"]
style = { fg = "bright_black", faint = true }

[[keywords]]
words = ["OK", "ok", "SUCCESS", "success", "Started", "started", "Reached", "Listening", "active", "running"]
style = { fg = "green" }

[[keywords]]
words = ["Stopped", "stopped", "Stopping", "inactive", "dead", "timeout", "denied", "refused", "unreachable"]
style = { fg = "yellow" }
