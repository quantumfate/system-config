#!/usr/bin/env bash
# logview — open a log source in the dedicated log workspace. Rendered by roles/zsh.
#
# Isolated from the coding session three ways: its own tmux server (socket
# "{{ zsh_tmux_log_socket }}"), its own kitty window (class
# "{{ zsh_kitty_log_class }}", pinned by a Hyprland windowrule), and its own CWD
# on tmpfs so a stray glob cannot wander into a project tree.
#
# Usage:
#   logview                 picker, then open in the log workspace
#   logview <spec>          open that spec directly (see `logstream`)
#   logview -h|--here       run in the CURRENT terminal, no kitty window
set -uo pipefail

SOCKET="{{ zsh_tmux_log_socket }}"
CONF="{{ target_home }}/.config/tmux/logs.conf"
WORKDIR="{{ zsh_log_workdir }}"
CLASS="{{ zsh_kitty_log_class }}"
SESSION="logs"

mkdir -p "$WORKDIR"

# ZSH_LOGVIEW keeps the shell in its quiet profile.
kitty_viewer() {
  exec kitty \
    --class "{{ zsh_kitty_log_class }}" \
    --title "logs" \
    --directory "$WORKDIR" \
    -o font_size={{ zsh_log_font_size }} \
    -o "window_padding_width={{ zsh_log_padding }}" \
    -o "modify_font=cell_height {{ zsh_log_line_height }}%" \
    -o tab_bar_style=hidden \
    -o confirm_os_window_close=0 \
    env ZSH_LOGVIEW=1 tmux -L "$SOCKET" -f "$CONF" attach -t "$SESSION"
}

here=0
case "${1:-}" in
  -h|--here) here=1; shift ;;
esac

spec="${1:-}"

# Window name = the source, truncated to keep the columns stable. uwsm app
# scopes (`app-Hyprland-kitty-ecc85322.scope`) are stripped down to the app.
wname() {
  local n="${1#*:}"
  n="${n%.service}"
  case "$n" in
    app-*.scope)
      n="${n%.scope}"
      n="${n#app-}"
      n="${n%-*}"        # trailing pid / random id
      n="${n##*-}"       # the compositor prefix uwsm adds
      n="${n##*.}"       # reverse-DNS ids: keep the last component
      n="${n//\\x2d/-}"
      ;;
  esac
  printf '%s' "$n" | cut -c1-18
}

session_exists() { tmux -L "$SOCKET" has-session -t "$SESSION" 2>/dev/null; }

# One window per source: re-running a spec returns to its window, never stacks
# a duplicate.
ensure_window() {
  local name="$1" cmd="$2"
  if ! session_exists; then
    tmux -L "$SOCKET" -f "$CONF" new-session -d -s "$SESSION" -c "$WORKDIR" -n "$name" "$cmd"
  elif tmux -L "$SOCKET" list-windows -t "$SESSION" -F '#W' | grep -Fxq "$name"; then
    :
  else
    tmux -L "$SOCKET" new-window -d -t "$SESSION" -c "$WORKDIR" -n "$name" "$cmd"
  fi
  tmux -L "$SOCKET" select-window -t "$SESSION:$name" 2>/dev/null
}

# Without this, logview from an unfocused workspace changes a window out of
# sight, which reads as the keybind doing nothing.
raise() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl dispatch focuswindow "class:^({{ zsh_kitty_log_class }})$" >/dev/null 2>&1 || true
}

viewer_running() { pgrep -f "kitty --class {{ zsh_kitty_log_class }}" >/dev/null 2>&1; }

# --- Run in the current terminal -------------------------------------------
if [ "$here" = 1 ]; then
  [ -n "$spec" ] || spec="$(logpick)" || exit 0
  exec logstream "$spec"
fi

# --- Pick a source ----------------------------------------------------------
# fzf needs a tty, and a Hyprland keybind gives none. So the picker runs inside
# the viewer as its own tmux window, and the chosen source replaces it there.
if [ -z "$spec" ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    spec="$(logpick)" || exit 0
  else
    ensure_window "pick" "logpickrun"
    if viewer_running; then
      raise
      exit 0
    fi
    kitty_viewer
  fi
fi

ensure_window "$(wname "$spec")" "logstream '$spec'"

if viewer_running; then
  raise
  exit 0
fi

kitty_viewer
