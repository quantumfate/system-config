[Unit]
Description=Apply the theme store's palette to every surface
Documentation=https://codeberg.org/quantumfate/scripts
# The fan-out pokes running kitty, GTK and Qt clients, so it wants a session to
# poke. Harmless without one: each applier is best-effort and the store is
# already correct either way.
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart={{ theme_apply_script }} apply
