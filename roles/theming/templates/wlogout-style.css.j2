# ~/.config/wlogout/style.css — rendered by roles/theming and recoloured by
# `,theme.sh apply_wlogout`. Do not edit by hand unless you also update the
# applier; the next palette change will overwrite this file.

* {
  font-family: "JetBrainsMono Nerd Font", "JetBrainsMono Nerd Font Mono";
  font-weight: 600;
  font-size: 15px;
  background-image: none;
  box-shadow: none;
  transition: all 0.2s ease;
}

window {
  background-color: transparent;
}

button {
  color: #cad3f5;
  background-color: rgba(30, 32, 48, 0.82);
  border: 1px solid rgba(73, 77, 100, 0.55);
  border-radius: 18px;
  margin: 10px;
  background-repeat: no-repeat;
  background-position: center 30%;
  background-size: 26%;
  outline: none;
}

button:hover {
  color: #c6a0f6;
  background-color: rgba(54, 58, 79, 0.92);
  border-color: #c6a0f6;
}

/* default (neutral) icons */
#lock      { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/lock.svg"); }
#logout    { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/logout.svg"); }
#suspend   { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/suspend.svg"); }
#hibernate { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/hibernate.svg"); }
#shutdown  { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/shutdown.svg"); }
#reboot    { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/text/reboot.svg"); }

/* accent icons on hover */
#lock:hover      { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/lock.svg"); }
#logout:hover    { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/logout.svg"); }
#suspend:hover   { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/suspend.svg"); }
#hibernate:hover { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/hibernate.svg"); }
#shutdown:hover  { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/shutdown.svg"); }
#reboot:hover    { background-image: url("/home/{{ n }}/.config/wlogout/catppuccin/icons/wlogout/{{ theme_flavour }}/{{ theme_accent }}/reboot.svg"); }
