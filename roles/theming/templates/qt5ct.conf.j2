{% import '_qtfont.j2' as qt -%}
# ~/.config/qt5ct/qt5ct.conf — rendered by roles/theming.
#
# The Qt5 twin of qt6ct.conf. The session names qt6ct because one variable
# cannot name both plugins; this is the fallback for Qt5 apps launched with
# QT_QPA_PLATFORMTHEME=qt5ct.
#
# Widgets from Kvantum, palette from the catppuccin colour scheme. Setting
# QT_STYLE_OVERRIDE in the environment would beat both.

[Appearance]
style=kvantum
color_scheme_path={{ target_home }}/.config/qt5ct/colors/{{ theme_qt_colors }}.conf
custom_palette=true
icon_theme={{ theme_icons }}
standard_dialogs=default

[Fonts]
general="{{ qt.qtfont(theme_ui_font, theme_ui_font_size) }}"
fixed="{{ qt.qtfont(theme_mono_font, theme_mono_font_size) }}"

[Interface]
activate_item_on_single_click=1
buttonbox_layout=0
cursor_flash_time=1000
dialog_buttons_have_icons=0
double_click_interval=400
gui_effects=@Invalid()
keyboard_scheme=2
menus_have_icons=false
show_shortcuts_in_context_menus=true
stylesheets=@Invalid()
toolbutton_style=4
underline_shortcut=1
wheel_scroll_lines=3
