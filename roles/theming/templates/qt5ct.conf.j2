{% import '_qtfont.j2' as qt -%}
# ~/.config/qt5ct/qt5ct.conf — rendered by roles/theming.
#
# The Qt5 twin of qt6ct.conf, kept identical so a Qt5 app (launched with
# QT_QPA_PLATFORMTHEME=qt5ct) is indistinguishable from a Qt6 one. The session
# environment names qt6ct, because Qt5's plugin only answers to "qt5ct" and a
# single variable cannot name both — modern apps are Qt6, this is the fallback.
#
# Style comes from Kvantum (the catppuccin Kvantum theme draws the widgets) and
# the palette from the catppuccin colour scheme; do NOT also set
# QT_STYLE_OVERRIDE in the environment — two style selectors fight, and the
# environment one wins over anything chosen here.

[Appearance]
style=kvantum
color_scheme_path={{ target_home }}/.config/qt5ct/colors/{{ theme_qt_colors }}.conf
custom_palette=true
icon_theme={{ theme_icons }}
standard_dialogs=default

[Fonts]
general="{{ qt.qtfont(theme_ui_font, theme_ui_font_size) }}"
fixed="{{ qt.qtfont(theme_mono_font, theme_mono_font_size) }}"

[Interface]
activate_item_on_single_click=1
buttonbox_layout=0
cursor_flash_time=1000
dialog_buttons_have_icons=0
double_click_interval=400
gui_effects=@Invalid()
keyboard_scheme=2
menus_have_icons=false
show_shortcuts_in_context_menus=true
stylesheets=@Invalid()
toolbutton_style=4
underline_shortcut=1
wheel_scroll_lines=3
