# ~/.config/gtk-4.0/settings.ini — rendered by roles/theming.
# Font, icons and cursor only. The widget theme comes from the gtk.css symlink
# tasks/main.yml creates — libadwaita ignores gtk-theme-name.
[Settings]
gtk-theme-name={{ theme_gtk }}
gtk-icon-theme-name={{ theme_icons }}
gtk-cursor-theme-name={{ theme_cursor }}
gtk-cursor-theme-size={{ theme_cursor_size }}
gtk-font-name={{ theme_ui_font }} {{ theme_ui_font_size }}
gtk-application-prefer-dark-theme={{ 1 if theme_flavour_is_dark else 0 }}
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
