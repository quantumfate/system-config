{#-
  QFont serialisation for qt5ct/qt6ct. They store fonts as an escaped
  QDataStream blob; a readable "Adwaita Sans,12" is silently ignored.

    \0\0\0@        QVariant type 64 (QFont)
    \0\0\0\xNN     byte length of the family name (UTF-16BE)
    \0X ...        the family name, one \0 + char per ASCII character
    @Y\0\0\0\0\0\0 point size, big-endian IEEE-754 double
    tail           weight/style/hint flags, identical for every font here

  _hexmap: QSettings escapes a hex digit following \0, so those go in as \xNN.
  _sizemap: second byte of the double per point size — add one to support more.
-#}
{%- set _hexmap = {
  '0': '30', '1': '31', '2': '32', '3': '33', '4': '34', '5': '35', '6': '36',
  '7': '37', '8': '38', '9': '39',
  'a': '61', 'b': '62', 'c': '63', 'd': '64', 'e': '65', 'f': '66',
  'A': '41', 'B': '42', 'C': '43', 'D': '44', 'E': '45', 'F': '46' } -%}
{%- set _sizemap = { 9: '"', 10: '$', 11: '&', 12: '(', 13: '*', 14: ',', 15: '.', 16: '0' } -%}
{%- macro qtfont(name, size) -%}
@Variant(\0\0\0@\0\0\0\x{{ '%02x' | format(name | length * 2) }}
{%- for ch in name %}\0{% if ch in _hexmap %}\x{{ _hexmap[ch] }}{% else %}{{ ch }}{% endif %}{% endfor %}
{#- -#}
@{{ _sizemap[size] }}\0\0\0\0\0\0\xff\xff\xff\xff\x5\x1\0\x32\x10)
{%- endmacro -%}
