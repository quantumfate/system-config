{#-
  QFont serialisation for qt5ct/qt6ct.

  Both store fonts as a QDataStream blob in QSettings' escaped form, NOT as a
  readable font string — a plain "Adwaita Sans,12" is silently ignored and Qt
  falls back to the fontconfig default. The layout, verified byte-for-byte
  against values qt6ct itself wrote:

    \0\0\0@        QVariant type 64 (QFont)
    \0\0\0\xNN     byte length of the family name (UTF-16BE, so 2 x characters)
    \0X ...        the family name, one \0 + char per ASCII character
    @Y\0\0\0\0\0\0 point size as a big-endian IEEE-754 double
    tail           weight/style/hint flags, identical for every font we write

  QSettings escapes the character after a \0 when it is a hex digit, otherwise
  \0a would read back as an escape sequence — hence the _hexmap below. The size
  map holds the second byte of the double for each supported point size
  (12.0 = 0x4028 -> "@("); add an entry to support another size.
-#}
{%- set _hexmap = {
  '0': '30', '1': '31', '2': '32', '3': '33', '4': '34', '5': '35', '6': '36',
  '7': '37', '8': '38', '9': '39',
  'a': '61', 'b': '62', 'c': '63', 'd': '64', 'e': '65', 'f': '66',
  'A': '41', 'B': '42', 'C': '43', 'D': '44', 'E': '45', 'F': '46' } -%}
{%- set _sizemap = { 9: '"', 10: '$', 11: '&', 12: '(', 13: '*', 14: ',', 15: '.', 16: '0' } -%}
{%- macro qtfont(name, size) -%}
@Variant(\0\0\0@\0\0\0\x{{ '%02x' | format(name | length * 2) }}
{%- for ch in name %}\0{% if ch in _hexmap %}\x{{ _hexmap[ch] }}{% else %}{{ ch }}{% endif %}{% endfor %}
{#- -#}
@{{ _sizemap[size] }}\0\0\0\0\0\0\xff\xff\xff\xff\x5\x1\0\x32\x10)
{%- endmacro -%}
