# ~/.config/gtk-3.0/settings.ini — rendered by roles/theming.
# GTK4 and the portals need the same values elsewhere — see tasks/main.yml.
[Settings]
gtk-theme-name={{ theme_gtk }}
gtk-icon-theme-name={{ theme_icons }}
gtk-cursor-theme-name={{ theme_cursor }}
gtk-cursor-theme-size={{ theme_cursor_size }}
gtk-font-name={{ theme_ui_font }} {{ theme_ui_font_size }}
gtk-application-prefer-dark-theme={{ 1 if theme_flavour_is_dark else 0 }}

# Icons only where they carry meaning alone: toolbars yes, menus/buttons no.
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-animations=1
gtk-primary-button-warps-slider=1

# hintslight + rgb: hintmedium distorts glyphs at these sizes.
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb

gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
