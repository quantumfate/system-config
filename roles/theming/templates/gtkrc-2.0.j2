# ~/.gtkrc-2.0.mine — rendered by roles/theming.
# GTK2 cannot use the catppuccin theme; it can at least match font and icons.
#
# The .mine file, not ~/.gtkrc-2.0: nwg-look overwrites that one and includes
# this, so edits here survive pressing Apply in its GUI.
gtk-theme-name="{{ theme_gtk }}"
gtk-icon-theme-name="{{ theme_icons }}"
gtk-cursor-theme-name="{{ theme_cursor }}"
gtk-cursor-theme-size={{ theme_cursor_size }}
gtk-font-name="{{ theme_ui_font }} {{ theme_ui_font_size }}"
gtk-button-images=0
gtk-menu-images=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
