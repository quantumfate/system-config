# nwg-look's own store, rendered by roles/theming so its GUI shows the truth
# and an accidental "Apply" writes back what is already here.
#
# The role never runs `nwg-look -a` — that re-exports every other themed file
# from this store, and it has no keys for menu images or the monospace font.
gtk-theme={{ theme_gtk }}
icon-theme={{ theme_icons }}
font-name={{ theme_ui_font }} {{ theme_ui_font_size }}
cursor-theme={{ theme_cursor }}
cursor-size={{ theme_cursor_size }}
toolbar-style=icons
toolbar-icons-size=large
font-hinting=slight
font-antialiasing=rgba
font-rgba-order=rgb
text-scaling-factor=1.0
color-scheme={{ 'prefer-dark' if theme_flavour_is_dark else 'prefer-light' }}
event-sounds=true
input-feedback-sounds=false
