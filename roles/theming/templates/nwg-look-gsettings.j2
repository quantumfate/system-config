# Generated by nwg-look, do not edit this file.
#
# ...except this copy is rendered by roles/theming, from the same variables as
# every other file it writes. nwg-look is a GUI over these values; keeping its
# store in sync means opening it shows the truth instead of stale settings that
# one careless "Apply" would push over the role's work.
#
# The role never runs `nwg-look -a`: that command re-exports settings.ini,
# .gtkrc-2.0, index.theme, xsettingsd and the GTK4 symlinks from this store, so
# running it after the templates would overwrite them (and it has no keys for
# button/menu images or the monospace font, which is why the templates exist).
gtk-theme={{ theme_gtk }}
icon-theme={{ theme_icons }}
font-name={{ theme_ui_font }} {{ theme_ui_font_size }}
cursor-theme={{ theme_cursor }}
cursor-size={{ theme_cursor_size }}
toolbar-style=icons
toolbar-icons-size=large
font-hinting=slight
font-antialiasing=rgba
font-rgba-order=rgb
text-scaling-factor=1.0
color-scheme=prefer-dark
event-sounds=true
input-feedback-sounds=false
