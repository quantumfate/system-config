[Unit]
Description=Follow the sun between the day and night palettes

[Timer]
# The script resolves day vs night itself, so the timer only has to ask often
# enough that the switch lands near the hour it is due. Hourly is plenty for a
# colour scheme and costs nothing.
OnCalendar={{ theme_auto_interval }}
# A switch missed while suspended or logged out applies once on resume — which
# is exactly the case that matters, since the machine is usually asleep across
# sunset.
Persistent=true
Unit=theme-auto.service

[Install]
WantedBy=timers.target
